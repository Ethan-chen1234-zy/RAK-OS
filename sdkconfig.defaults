# Waveshare ESP32-S3-Touch-AMOLED-1.8 (N16R8: 16MB flash + 8MB OPI PSRAM)
# ROM bootloader starts in DIO; app/bootloader switches to QIO at runtime.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# WiFi + BLE (Setup radio page)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_WIFI_ENABLED=y

# Roll back to ota_0 if a newly installed app (ota_1) fails first boot
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
